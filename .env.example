# Copia este archivo como .env y completa los valores. No subas .env al repositorio.
# MySQL 8 compartido por la web y la app JavaFX (misma base, mismas tablas).
DATABASE_URL=mysql+pymysql://miramar_user:change-me@127.0.0.1:3306/miramar?charset=utf8mb4
SECRET_KEY=change-me
TIMEZONE=America/Lima

# Usuario administrador inicial (solo se usa en el seed).
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@miramarhotel.pe
ADMIN_SEED_PASSWORD=change-me

# Puerto de Flask y entorno de ejecución.
PORT=5000
FLASK_ENV=development

# Minutos de inactividad antes de cerrar la sesión del panel.
ADMIN_IDLE_MINUTES=30

# Credenciales del contenedor Docker (opcionales, solo para docker-compose).
MYSQL_ROOT_PASSWORD=root-change-me
MYSQL_DATABASE=miramar
MYSQL_USER=miramar_user
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
